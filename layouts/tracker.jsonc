{
  //sets the trackers layout
  //more info: https://github.com/black-sliver/PopTracker/blob/master/doc/PACKS.md#layouts
  "tracker_default": {
    "type": "container",
    "background": "#000000",
    "content": {
      "type": "dock",
      "dropshadow": true,
      "content": [
        {
          "type": "tabbed",
          "tabs": [
            {
              "title": "Technologies",
              "content": {
                "type": "tabbed",
                "tabs": [
                  {
                    "title": "Ancient Classical",
                    "content": {
                      "type": "map",
                      "maps": [
                        "AnciClassEra"
                      ]
                    }
                  },
                  {
                    "title": "Medieval Rennaissance Industrial",
                    "content": {
                      "type": "map",
                      "maps": [
                        "MediRennaiInduEra"
                      ]
                    }
                  },
                  {
                    "title": "Modern Atomic Information",
                    "content": {
                      "type": "map",
                      "maps": [
                        "ModAtomInfoEra"
                      ]
                    }
                  }
                ]
              }
            },
            {
              "title": "Policies",
              "content": {
                "type": "map",
                "maps": [
                  "Policies"
                ]
              }
            }
          ]
        }
      ]
    }
  }
}